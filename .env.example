# Copy this file to .env and adjust values as needed.
# Docker Compose loads .env automatically from the project root.

# --- Database ---
DB_NAME=inventory_db
DB_USERNAME=postgres
DB_PASSWORD=password
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
FRONTEND_PORT=3000
# Base URL the browser will call for the API. Must be reachable from the
# user's browser (not from inside the Docker network), since this is baked
# into the JS bundle at build time.
VITE_API_URL=http://localhost:8080/api/v1
